{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "./dist",
    "strict": false,
    "noEmit": false,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts", "**/*.d.ts", "**/*.js", "**/*.mjs", "**/*.cjs"],
  "exclude": ["**/ui/*", "node_modules", "**/node_modules", "**/_archive", "dist", "build", ".azure", "coverage"]
}
