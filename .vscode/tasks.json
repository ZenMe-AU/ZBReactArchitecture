{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RunChain",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Install Dependencies",
        {
          "task": "Start",
          "workspaceFolder": "${workspaceFolder:Q3 Func}"
        },
        {
          "task": "Start",
          "workspaceFolder": "${workspaceFolder:Q3 UI}"
        },
        {
          "task": "Start",
          "workspaceFolder": "${workspaceFolder:Portal UI}"
        }
      ]
    },
    {
      "type": "shell",
      "label": "Install Dependencies",
      "command": "pnpm install",
      "options": {
        "cwd": "${workspaceFolder:ROOT}"
      }
    },
    {
      "label": "Start Azurite",
      "type": "shell",
      "command": "pnpm",
      "args": ["exec", "azurite", "--silent", "--location", "${workspaceFolder:ROOT}/azurite", "--debug", "${workspaceFolder:ROOT}/azurite/debug.log"],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder:ROOT}"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^.*[Ee]rror.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Azurite Blob service is starting",
          "endsPattern": "Azurite Table service is successfully listening"
        }
      }
    },
    {
      "type": "func",
      "label": "func: host start",
      "command": "host start",
      "problemMatcher": "$func-node-watch",
      "isBackground": true,
      "dependsOn": "npm watch (functions)",
      "options": {
        "cwd": "${workspaceFolder}/module/quest3Tier/func"
      }
    },
    {
      "type": "shell",
      "label": "npm build (functions)",
      "command": "npm run build",
      "dependsOn": "npm install (functions)",
      "problemMatcher": "$tsc",
      "options": {
        "cwd": "${workspaceFolder}/module/quest3Tier/func"
      }
    },
    {
      "type": "shell",
      "label": "npm watch (functions)",
      "command": "npm run watch",
      "dependsOn": "npm install (functions)",
      "problemMatcher": "$tsc-watch",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/module/quest3Tier/func"
      }
    },
    {
      "type": "shell",
      "label": "npm install (functions)",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/module/quest3Tier/func"
      }
    },
    {
      "type": "shell",
      "label": "npm prune (functions)",
      "command": "npm prune --production",
      "dependsOn": "npm build (functions)",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/module/quest3Tier/func"
      }
    }
  ]
}
