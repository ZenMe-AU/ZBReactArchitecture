{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start",
      "type": "shell",
      "command": "pnpm run start",
      "isBackground": true,
      "problemMatcher": "$func-node-watch"
    },
    {
      "label": "Start Agent Test API",
      "type": "shell",
      "command": "pnpm run start",
      "options": { "env": { "AUTH_PROVIDER": "authLocal" } },
      "isBackground": true,
      "dependsOn": [
        {
          "task": "Start Azurite",
          "workspaceFolder": "${workspaceFolder:ROOT}"
        }
      ],
      "problemMatcher": "$func-node-watch"
    },
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "pnpm install --frozen-lockfile"
    }
  ]
}
