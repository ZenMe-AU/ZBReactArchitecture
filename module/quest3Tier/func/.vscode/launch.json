{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Agent UI",
      "type": "node",
      "request": "launch",
      "autoAttachChildProcesses": false,
      "program": "${workspaceFolder}/dist/vitest/agents/viewer/server.mjs",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Start Agent Test API",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Start Agent Vitest",
      "type": "node",
      "request": "launch",
      "autoAttachChildProcesses": false,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "program": "${workspaceFolder}/../../../node_modules/vitest/vitest.mjs",
      "args": ["run", "module/quest3Tier/func/vitest/agents/agentChat.test.mts", "--disableConsoleIntercept"],
      "env": { "AGENT_RUN": "1" },
      "cwd": "${workspaceFolder}/../../..",
      "preLaunchTask": "Start Agent Test API",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Start",
      "type": "node",
      "request": "attach",
      "restart": true,
      "port": 9229,
      "preLaunchTask": "Start"
    }
  ]
}
